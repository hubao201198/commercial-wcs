FROM node:22-alpine AS web
WORKDIR /src/frontend
COPY frontend/package.json frontend/tsconfig.json frontend/index.html ./
COPY frontend/src ./src
RUN npm install
RUN npm run build

FROM golang:1.24-alpine AS api
WORKDIR /src/backend
COPY backend/go.mod ./
RUN go mod download
COPY backend ./
COPY --from=web /src/frontend/dist ./public
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /warehouse-os .

FROM alpine:3.21
RUN addgroup -g 10001 app && adduser -D -u 10001 -G app app
WORKDIR /app
COPY --from=api /warehouse-os /app/warehouse-os
COPY --from=api /src/backend/public /app/public
USER app
ENV PORT=3000
EXPOSE 3000
CMD ["/app/warehouse-os"]
